diff --git a/app/models/discovery_response.py b/app/models/discovery_response.py
index 407160f..470b4c9 100644
--- a/app/models/discovery_response.py
+++ b/app/models/discovery_response.py
@@ -1,8 +1,25 @@
 from __future__ import annotations
 
+from typing import TypedDict
+
 from pydantic import BaseModel
 
 
+class DiscoveryPayload(TypedDict):
+    """The well-known discovery record, before pydantic validation.
+
+    Names the shape the raw dict must satisfy instead of hiding a dropped
+    key behind ``Any``.
+    """
+
+    service: str
+    version: str
+    policy_schema_version: str
+    links: dict[str, str]
+    recommended_endpoints: list[str]
+    description: str
+
+
 class DiscoveryResponse(BaseModel):
     service: str
     version: str
diff --git a/app/models/error_response.py b/app/models/error_response.py
index ad2e132..6a49c11 100644
--- a/app/models/error_response.py
+++ b/app/models/error_response.py
@@ -1,9 +1,23 @@
 from __future__ import annotations
 
-from typing import Any
+from typing import Any, TypedDict
 
 from pydantic import BaseModel, Field
 
+from app.models.json_value import JsonValue
+
+
+class ErrorEnvelope(TypedDict):
+    """The wire error shape: a stable code, a message, and open details.
+
+    ``details`` is carried verbatim to the serialized body, so it is
+    ``JsonValue`` -- arbitrary JSON -- not a declared record.
+    """
+
+    code: str
+    message: str
+    details: JsonValue
+
 
 class ErrorResponse(BaseModel):
     code: str = Field(description="Stable machine-readable error code.")
