# crawlutron environment variables.
#
# HOW LOADING WORKS (M4): nothing in this service auto-loads a .env file.
# Docker Compose reads the .env NEXT TO THIS COMPOSE FILE for ${VAR}
# interpolation into `docker-compose.yml` -- every variable you want to reach
# the container must either be referenced there, or run via
# `docker run --env-file .env`. Values shown below are the app defaults
# (app/settings.CrawlerSettings and the module-level defaults cited per knob);
# overriding any of them is optional.

# --- Network / server ---
# Bind interface (M15): loopback by default; set 0.0.0.0 only behind a
# loopback ports mapping or reverse proxy (the compose file does this).
CRAWLUTRON_HOST=127.0.0.1
CRAWLUTRON_GLOBAL_CONCURRENCY=4
CRAWLUTRON_PER_DOMAIN_CONCURRENCY=2
CRAWLUTRON_PER_DOMAIN_DELAY_MS=500
CRAWLUTRON_MAX_BATCH_SIZE=50

# --- Crawl defaults ---
CRAWLUTRON_DEFAULT_TIMEOUT_SECONDS=30
CRAWLUTRON_DEFAULT_MAX_RETRIES=2
# Unrecognized non-empty values are rejected with a warning and fall back to
# the default (True = robots.txt respected; fail-closed).
CRAWLUTRON_RESPECT_ROBOTS=true

# --- Host policy ---
# Comma-separated allowlist/denylist (suffix match; case, IDNA, and port normalized).
# Deny entries win when a host matches both lists; an empty allowlist permits all.
CRAWLUTRON_ALLOWED_HOSTS=
CRAWLUTRON_DENIED_HOSTS=

# --- Local-mode SSRF bypass ---
# Set to "1" to allow loopback/private targets (Docker-internal Caddy, local
# stacks, automated tests). DO NOT enable in public-facing deployments.
CRAWLUTRON_ALLOW_PRIVATE_TARGETS=0

# --- Logging ---
CRAWLUTRON_LOG_LEVEL=info
CRAWLUTRON_LOG_FILE=/app/logs/crawlutron.jsonl
CRAWLUTRON_LOG_MAX_BYTES=10485760
CRAWLUTRON_LOG_BACKUP_COUNT=3

# --- Disk caches ---
CRAWLUTRON_CACHE_DIR=/app/cache
CRAWLUTRON_CACHE_TTL_SECONDS=3600
# Opt-in: store decompressed response bodies for replay. Default off because
# each entry can be ~67 MB and TTL eviction is bounded only by max_entries.
CRAWLUTRON_CONTENT_CACHE_ENABLED=false
# Cap (bytes) for the in-RAM mirror of the disk content cache (http.py).
CRAWLUTRON_CONTENT_RAM_BUDGET_BYTES=1073741824

# --- Adaptive throttling ---
CRAWLUTRON_ADAPTIVE_THROTTLING=true
CRAWLUTRON_ADAPTIVE_MIN_DELAY=0.5
CRAWLUTRON_ADAPTIVE_MAX_DELAY=10.0
CRAWLUTRON_ADAPTIVE_LATENCY_FACTOR=1.0

# --- Persistent cookie jar (opt-in; multi-tenant callers should also set
# request_profile.cookie_namespace per crawl) ---
CRAWLUTRON_COOKIE_PERSISTENCE_ENABLED=false
CRAWLUTRON_COOKIE_JAR_PATH=/app/cache/cookie_jar.json

# --- HTTP client pool ---
CRAWLUTRON_HTTP_MAX_CONNECTIONS=100
CRAWLUTRON_HTTP_MAX_KEEPALIVE=20
CRAWLUTRON_HTTP_KEEPALIVE_EXPIRY=60.0

# --- Browser runtime limits ---
CRAWLUTRON_MAX_BROWSER_RENDERS=8
CRAWLUTRON_MAX_CONCURRENT_PAGES=16
CRAWLUTRON_BROWSER_POOL_SIZE=2
CRAWLUTRON_CHALLENGE_WAIT_SECONDS=8
# Browser fixed-overhead knobs (defaults 3 / 1 / 5.0; changing them only
# trades completeness/latency, it never changes what is extracted).
CRAWLUTRON_LAZY_SCROLL_STEPS=3
CRAWLUTRON_LAZY_SCROLL_DELAY_SECONDS=1
CRAWLUTRON_COOKIE_HARVEST_TIMEOUT_SECONDS=5.0
# Headless browser launches (browser.py). Empty user agent = engine default.
CRAWLUTRON_HEADLESS=true
CRAWLUTRON_USER_AGENT=
# Comma-separated URLs fetched once at startup to warm engine caches
# (browser.py); leave empty to disable.
CRAWLUTRON_WARMUP_URLS=

# --- Web search (POST /v1/search) ---
# Provider selection: "auto" activates the first keyed provider configured
# below (tavily -> brave -> serper); "duckduckgo" is the keyless fallback and
# may be captcha-blocked from datacenter IPs. An explicit provider name
# requires its matching API key.
CRAWLUTRON_SEARCH_PROVIDER=auto
CRAWLUTRON_TAVILY_API_KEY=
CRAWLUTRON_BRAVE_API_KEY=
CRAWLUTRON_SERPER_API_KEY=
CRAWLUTRON_SEARCH_LIMIT_DEFAULT=5
CRAWLUTRON_SEARCH_LIMIT_MAX=20
CRAWLUTRON_SEARCH_TIMEOUT_SECONDS=15

# --- Webhooks (async crawl completion callbacks) ---
# Per-payload cap (bytes) and delivery concurrency (webhooks.py).
CRAWLUTRON_MAX_WEBHOOK_SIZE=10485760
CRAWLUTRON_MAX_WEBHOOK_CONCURRENCY=4

# --- Async crawl result store (main.py) ---
CRAWLUTRON_RESULT_MAX_ENTRIES=1000
CRAWLUTRON_RESULT_TTL_SECONDS=3600

# --- Document extraction (extraction.py) ---
CRAWLUTRON_EXTRACTION_DOC_ENABLED=true
CRAWLUTRON_EXTRACTION_DOC_WORKERS=2
CRAWLUTRON_EXTRACTION_DOC_TIMEOUT=10.0
# Cap (bytes) on document bodies admitted for extraction.
CRAWLUTRON_EXTRACTION_DOC_MAX_BYTES=20971520
# Selector settle timeout (extraction.py).
CRAWLUTRON_EXTRACTION_SELECTOR_TIMEOUT=2.0

# --- Resource pressure / admission control (resource_pressure.py) ---
# Per-task RAM budgets and the hard concurrency ceilings behind them.
CRAWLUTRON_HTTP_TASK_RAM_BYTES=12582912
CRAWLUTRON_BROWSER_TASK_RAM_BYTES=734003200
CRAWLUTRON_BROWSER_RAM_BYTES=734003200
CRAWLUTRON_BROWSER_RAM_FRACTION=0.5
CRAWLUTRON_MAX_HTTP_CONCURRENCY=512
CRAWLUTRON_MAX_DERIVED_POOL_SIZE=4
CRAWLUTRON_ADMIT_YIELD_SECONDS=0.05
# Opt-in event-loop lag probe (diagnostics only).
CRAWLUTRON_LOOP_LAG_PROBE=0

# --- Test hooks (extraction kill/restart semantics) ---
# MUST be "1" for the TEST_* hooks to exist at all; gate-less flags are ignored.
CRAWLUTRON_TEST_HOOKS=

# --- probe_session.py only ---
# CRAWLUTRON_PROBE_TARGET=https://www.worcesterma.gov/
# CRAWLUTRON_PROBE_OUTPUT=/app/tmp/probe_out.txt
