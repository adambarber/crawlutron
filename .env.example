# browser-crawler environment variables.
#
# HOW LOADING WORKS (M4): nothing in this service auto-loads a .env file.
# Docker Compose reads the .env NEXT TO THIS COMPOSE FILE for ${VAR}
# interpolation into `docker-compose.yml` -- every variable you want to reach
# the container must either be referenced there, or run via
# `docker run --env-file .env`. Values shown below are the app defaults
# (app/settings.CrawlerSettings and the module-level defaults cited per knob);
# overriding any of them is optional.

# --- Network / server ---
# Bind interface (M15): loopback by default; set 0.0.0.0 only behind a
# loopback ports mapping or reverse proxy (the compose file does this).
BROWSER_CRAWLER_HOST=127.0.0.1
BROWSER_CRAWLER_HOST_PORT=8765
BROWSER_CRAWLER_GLOBAL_CONCURRENCY=4
BROWSER_CRAWLER_PER_DOMAIN_CONCURRENCY=2
BROWSER_CRAWLER_PER_DOMAIN_DELAY_MS=500
BROWSER_CRAWLER_MAX_BATCH_SIZE=50

# --- Crawl defaults ---
BROWSER_CRAWLER_DEFAULT_TIMEOUT_SECONDS=30
BROWSER_CRAWLER_DEFAULT_MAX_RETRIES=2
# Unrecognized non-empty values are rejected with a warning and fall back to
# the default (True = robots.txt respected; fail-closed).
BROWSER_CRAWLER_RESPECT_ROBOTS=true

# --- Host policy ---
# Comma-separated allowlist/denylist (suffix match).
BROWSER_CRAWLER_ALLOWED_HOSTS=
BROWSER_CRAWLER_DENIED_HOSTS=

# --- Local-mode SSRF bypass ---
# Set to "1" to allow loopback/private targets (Docker-internal Caddy, local
# stacks, automated tests). DO NOT enable in public-facing deployments.
BROWSER_CRAWLER_ALLOW_PRIVATE_TARGETS=0

# --- Logging ---
BROWSER_CRAWLER_LOG_LEVEL=info
BROWSER_CRAWLER_LOG_FILE=/app/logs/browser-crawler.jsonl
BROWSER_CRAWLER_LOG_MAX_BYTES=10485760
BROWSER_CRAWLER_LOG_BACKUP_COUNT=3

# --- Disk caches ---
BROWSER_CRAWLER_CACHE_DIR=/app/cache
BROWSER_CRAWLER_CACHE_TTL_SECONDS=3600
# Opt-in: store decompressed response bodies for replay. Default off because
# each entry can be ~67 MB and TTL eviction is bounded only by max_entries.
BROWSER_CRAWLER_CONTENT_CACHE_ENABLED=false
# Cap (bytes) for the in-RAM mirror of the disk content cache (http.py).
BROWSER_CRAWLER_CONTENT_RAM_BUDGET_BYTES=1073741824

# --- Adaptive throttling ---
BROWSER_CRAWLER_ADAPTIVE_THROTTLING=true
BROWSER_CRAWLER_ADAPTIVE_MIN_DELAY=0.5
BROWSER_CRAWLER_ADAPTIVE_MAX_DELAY=10.0
BROWSER_CRAWLER_ADAPTIVE_LATENCY_FACTOR=1.0

# --- Persistent cookie jar (opt-in; multi-tenant callers should also set
# request_profile.cookie_namespace per crawl) ---
BROWSER_CRAWLER_COOKIE_PERSISTENCE_ENABLED=false
BROWSER_CRAWLER_COOKIE_JAR_PATH=/app/cache/cookie_jar.json

# --- HTTP client pool ---
BROWSER_CRAWLER_HTTP_MAX_CONNECTIONS=100
BROWSER_CRAWLER_HTTP_MAX_KEEPALIVE=20
BROWSER_CRAWLER_HTTP_KEEPALIVE_EXPIRY=60.0

# --- Browser runtime limits ---
BROWSER_CRAWLER_MAX_BROWSER_RENDERS=8
BROWSER_CRAWLER_MAX_CONCURRENT_PAGES=16
BROWSER_CRAWLER_BROWSER_POOL_SIZE=2
BROWSER_CRAWLER_CHALLENGE_WAIT_SECONDS=8
# Browser fixed-overhead knobs (defaults 3 / 1 / 5.0; changing them only
# trades completeness/latency, it never changes what is extracted).
BROWSER_CRAWLER_LAZY_SCROLL_STEPS=3
BROWSER_CRAWLER_LAZY_SCROLL_DELAY_SECONDS=1
BROWSER_CRAWLER_COOKIE_HARVEST_TIMEOUT_SECONDS=5.0
# Headless browser launches (browser.py). Empty user agent = engine default.
BROWSER_CRAWLER_HEADLESS=true
BROWSER_CRAWLER_USER_AGENT=
# Comma-separated URLs fetched once at startup to warm engine caches
# (browser.py); leave empty to disable.
BROWSER_CRAWLER_WARMUP_URLS=

# --- Web search (POST /v1/search) ---
# Provider selection: "auto" activates the first keyed provider configured
# below (tavily -> brave -> serper); "duckduckgo" is the keyless fallback and
# may be captcha-blocked from datacenter IPs. An explicit provider name
# requires its matching API key.
BROWSER_CRAWLER_SEARCH_PROVIDER=auto
BROWSER_CRAWLER_TAVILY_API_KEY=
BROWSER_CRAWLER_BRAVE_API_KEY=
BROWSER_CRAWLER_SERPER_API_KEY=
BROWSER_CRAWLER_SEARCH_LIMIT_DEFAULT=5
BROWSER_CRAWLER_SEARCH_LIMIT_MAX=20
BROWSER_CRAWLER_SEARCH_TIMEOUT_SECONDS=15

# --- Webhooks (async crawl completion callbacks) ---
# Per-payload cap (bytes) and delivery concurrency (webhooks.py).
BROWSER_CRAWLER_MAX_WEBHOOK_SIZE=10485760
BROWSER_CRAWLER_MAX_WEBHOOK_CONCURRENCY=4

# --- Async crawl result store (main.py) ---
BROWSER_CRAWLER_RESULT_MAX_ENTRIES=1000
BROWSER_CRAWLER_RESULT_TTL_SECONDS=3600

# --- Document extraction (extraction.py) ---
BROWSER_CRAWLER_EXTRACTION_DOC_ENABLED=true
BROWSER_CRAWLER_EXTRACTION_DOC_WORKERS=2
BROWSER_CRAWLER_EXTRACTION_DOC_TIMEOUT=10.0
# Cap (bytes) on document bodies admitted for extraction.
BROWSER_CRAWLER_EXTRACTION_DOC_MAX_BYTES=20971520
# Selector settle timeout (extraction.py).
BROWSER_CRAWLER_EXTRACTION_SELECTOR_TIMEOUT=2.0

# --- Resource pressure / admission control (resource_pressure.py) ---
# Per-task RAM budgets and the hard concurrency ceilings behind them.
BROWSER_CRAWLER_HTTP_TASK_RAM_BYTES=12582912
BROWSER_CRAWLER_BROWSER_TASK_RAM_BYTES=734003200
BROWSER_CRAWLER_BROWSER_RAM_BYTES=734003200
BROWSER_CRAWLER_BROWSER_RAM_FRACTION=0.5
BROWSER_CRAWLER_MAX_HTTP_CONCURRENCY=512
BROWSER_CRAWLER_MAX_DERIVED_POOL_SIZE=4
BROWSER_CRAWLER_ADMIT_YIELD_SECONDS=0.05
# Opt-in event-loop lag probe (diagnostics only).
BROWSER_CRAWLER_LOOP_LAG_PROBE=0

# --- Test hooks (extraction kill/restart semantics) ---
# MUST be "1" for the TEST_* hooks to exist at all; gate-less flags are ignored.
BROWSER_CRAWLER_TEST_HOOKS=

# --- probe_session.py only ---
# BROWSER_CRAWLER_PROBE_TARGET=https://www.worcesterma.gov/
# BROWSER_CRAWLER_PROBE_OUTPUT=/app/tmp/probe_out.txt
