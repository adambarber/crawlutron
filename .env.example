# crawlutron environment variables.
#
# HOW LOADING WORKS: nothing in this service auto-loads a .env file.
# Docker Compose reads the .env NEXT TO THIS COMPOSE FILE for ${VAR}
# interpolation into `docker-compose.yml` -- every variable you want to reach
# the container must either be referenced there, or run via
# `docker run --env-file .env`. Values shown below are the app defaults
# (packages/core/crawlutron/config/settings.py CrawlerSettings and the module-level defaults cited per knob);
# overriding any of them is optional.

# Unknown keys in an explicit mapping are refused (fail-loud): only the
# CRAWLUTRON_* keys actually read by the settings readers are recognized. The
# alias-source field forms (e.g. CRAWLUTRON_LOG_FILE_PATH) are unknown keys;
# use the alias targets (e.g. CRAWLUTRON_LOG_FILE).

# --- Network / server ---
# Bind interface: loopback by default; set 0.0.0.0 only behind a
# loopback ports mapping or reverse proxy (the compose file does this).
CRAWLUTRON_HOST=127.0.0.1
# uvicorn worker processes (Dockerfile CMD; pressure_sizing.worker_count).
# Keep at 1: the browser pool is per-process, so N workers multiply it N times
# against one shared RAM budget (see the README OOM warning).
CRAWLUTRON_WORKERS=1
CRAWLUTRON_GLOBAL_CONCURRENCY=4
CRAWLUTRON_PER_DOMAIN_CONCURRENCY=2
CRAWLUTRON_PER_DOMAIN_DELAY_MS=500
CRAWLUTRON_MAX_BATCH_SIZE=50

# --- Crawl defaults ---
CRAWLUTRON_DEFAULT_TIMEOUT_SECONDS=30
CRAWLUTRON_DEFAULT_MAX_RETRIES=5
# Unrecognized non-empty values are rejected with a warning and fall back to
# the default (True = robots.txt respected; fail-closed).
CRAWLUTRON_RESPECT_ROBOTS=true

# --- Host policy ---
# Comma-separated allowlist/denylist (suffix match; case, IDNA, and port normalized).
# Deny entries win when a host matches both lists; an empty allowlist permits all.
CRAWLUTRON_ALLOWED_HOSTS=
CRAWLUTRON_DENIED_HOSTS=

# --- Egress proxy ---
# Operator-configured egress proxy endpoint for default-deny topology.
# Empty (default) -> in-process loopback listener.
# Configured (e.g. http://egress-proxy:8888) -> use that sidecar, no in-process listener.
# The value is validated: scheme must be http/https, no userinfo, no query/fragment/path,
# host required, port 1-65535. Private container hostnames/addresses are allowed.
CRAWLUTRON_EGRESS_PROXY_URL=

# --- Local-mode SSRF bypass ---
# Set to 1/true/yes/on (case-insensitive) to allow loopback/private targets
# (Docker-internal Caddy, local stacks, automated tests). DO NOT enable in
# public-facing deployments. Enabling it logs a WARNING at first use and opens
# the service to cloud metadata endpoints; any other value (including 0,
# false, no, off, or garbage) refuses to open the hatch and warns on garbage.
CRAWLUTRON_ALLOW_PRIVATE_TARGETS=0

# --- Logging ---
CRAWLUTRON_LOG_LEVEL=info
# CRAWLUTRON_LOG_FILE=./logs/crawlutron.jsonl  # repo-relative default; the container overrides to /app/logs/crawlutron.jsonl
CRAWLUTRON_LOG_MAX_BYTES=10485760
CRAWLUTRON_LOG_BACKUP_COUNT=3

# --- Disk caches ---
CRAWLUTRON_CACHE_DIR=/app/cache
# CACHE_DIR is also the allowlist root for browser_profile.storage_state: a
# storage_state path is honored only under this directory; anything else is
# dropped with a WARNING. No CACHE_DIR means no storage_state is accepted
# (driver_config.validate_storage_state_path).
# Clamped to [0, 86400] (values outside fall back within the clamp). 0 -- or a
# negative, which clamps to 0 -- means NO cache: nothing is stored, never
# "use the default" and never "cache forever" (env.py + freshness.stores_for_ttl).
CRAWLUTRON_CACHE_TTL_SECONDS=3600
# Opt-in: store decompressed response bodies for replay. Default off because
# each entry can be ~67 MB and TTL eviction is bounded only by max_entries.
CRAWLUTRON_CONTENT_CACHE_ENABLED=false
# Cap (bytes) for the in-RAM mirror of the disk content cache (http.py).
CRAWLUTRON_CONTENT_RAM_BUDGET_BYTES=1073741824

# --- Adaptive throttling ---
CRAWLUTRON_ADAPTIVE_THROTTLING=true
CRAWLUTRON_ADAPTIVE_MIN_DELAY=0.5
CRAWLUTRON_ADAPTIVE_MAX_DELAY=10.0
CRAWLUTRON_ADAPTIVE_LATENCY_FACTOR=1.0

# --- Persistent cookie jar (opt-in; multi-tenant callers should also set
# request_profile.cookie_namespace per crawl) ---
CRAWLUTRON_COOKIE_PERSISTENCE_ENABLED=false
CRAWLUTRON_COOKIE_JAR_PATH=/app/cache/cookie_jar.json

# --- HTTP client pool ---
# Both pool ceilings are RAM-derived (the cgroup limit, floor 100 / cap 512; keepalive
# tracks half the connection ceiling) so they can never sit below the weighted
# admission's HTTP concurrency. Uncomment to pin an explicit value.
# CRAWLUTRON_HTTP_MAX_CONNECTIONS=100
# CRAWLUTRON_HTTP_MAX_KEEPALIVE=50
CRAWLUTRON_HTTP_KEEPALIVE_EXPIRY=60.0

# --- Browser runtime limits ---
CRAWLUTRON_MAX_BROWSER_RENDERS=100
CRAWLUTRON_MAX_CONCURRENT_PAGES=3
# Watches: one registry per caller, bounded so an anonymous flood cannot grow it unbounded.
CRAWLUTRON_MAX_WATCHES_PER_CALLER=100
# Browser-pool size has no fixed default: the pool is sized from the cgroup
# memory limit (pressure_sizing.derive_browser_pool_size) because each
# instance costs ~700 MiB of the RAM budget -- 2 instances at the compose
# file's 3g mem_limit, 1 when no limit is discoverable. Uncomment to pin an
# explicit fleet total instead (divided across CRAWLUTRON_WORKERS); see the
# README OOM warning before raising it.
# CRAWLUTRON_BROWSER_POOL_SIZE=2
CRAWLUTRON_CHALLENGE_WAIT_SECONDS=15
# Browser fixed-overhead knobs (defaults 3 / 1 / 5.0; changing them only
# trades completeness/latency, it never changes what is extracted).
CRAWLUTRON_LAZY_SCROLL_STEPS=3
CRAWLUTRON_LAZY_SCROLL_DELAY_SECONDS=1
CRAWLUTRON_COOKIE_HARVEST_TIMEOUT_SECONDS=5.0
# Headless browser launches (browser.py). Empty user agent = engine default.
CRAWLUTRON_HEADLESS=true
CRAWLUTRON_USER_AGENT=
# Comma-separated URLs fetched once at startup to warm engine caches
# (browser.py); leave empty to disable.
CRAWLUTRON_WARMUP_URLS=

# --- Web search (POST /v1/search) ---
# Provider selection: "auto" activates the first keyed provider configured
# below (tavily -> brave -> serper); "duckduckgo" is the keyless fallback and
# may be captcha-blocked from datacenter IPs. An explicit provider name
# requires its matching API key.
CRAWLUTRON_SEARCH_PROVIDER=auto
CRAWLUTRON_TAVILY_API_KEY=
CRAWLUTRON_BRAVE_API_KEY=
CRAWLUTRON_SERPER_API_KEY=
CRAWLUTRON_SEARCH_LIMIT_DEFAULT=5
CRAWLUTRON_SEARCH_LIMIT_MAX=20
CRAWLUTRON_SEARCH_TIMEOUT_SECONDS=15

# --- Key management (operator token for /v1/keys) ---
# Empty disables issuance/listing/revocation over HTTP. Set to a long random
# secret to let an operator mint and revoke caller keys.
# Rotation: redeploy the service with a new value (constant-time compare via
# secrets.compare_digest; there is no in-place hot rotation). Old tokens stop
# working on the next process start.
CRAWLUTRON_KEY_ADMIN_TOKEN=

# --- Webhooks (async crawl completion callbacks) ---
# Per-payload cap (bytes) and delivery concurrency (webhooks.py).
CRAWLUTRON_MAX_WEBHOOK_SIZE=10485760
CRAWLUTRON_MAX_WEBHOOK_CONCURRENCY=4
# Signed retries: shared HMAC secret (empty disables signing) and delivery backoff.
CRAWLUTRON_WEBHOOK_SECRET=
CRAWLUTRON_WEBHOOK_MAX_ATTEMPTS=3
CRAWLUTRON_WEBHOOK_BACKOFF_BASE_MS=200
# Both webhook doors (crawl + watch) are https-only: webhook_url must use https://.

# --- Async crawl result store (main.py) ---
CRAWLUTRON_RESULT_MAX_ENTRIES=1000
CRAWLUTRON_RESULT_TTL_SECONDS=3600

# --- Retention sweep (garbage row reclamation) ---
# Tombstones are physically reclaimed this many seconds after deletion. 86400s
# (24h) is our stated retention promise; younger tombstones survive so idempotent
# deletes stay safe. Out-of-range is refused with a WARNING, never silently
# clamped. The ceiling is one year (365 * 24 * 3600 = 31536000s), a sane upper
# bound: nothing useful is gained by keeping tombstones past a year, and the
# bound stops an operator typo from deleting every tombstone at once.
CRAWLUTRON_RETENTION_SWEEP_GRACE_SECONDS=86400

# --- crawl CLI facade (thin HTTP client, issue #710) ---
# Base URL of the crawl service the `crawl` client talks to (default http://127.0.0.1:8765).
CRAWLUTRON_BASE_URL=http://127.0.0.1:8765
# API key the `crawl` client sends as X-API-Key (unset = anonymous caller).
CRAWLUTRON_API_KEY=

# --- Sitemap freshness (engine.py) ---
# A <lastmod> further in the future than this is treated as untrustworthy
# rather than fresh (broken generators re-stamp the whole sitemap "now-plus"
# on every regeneration), and parses as if absent so the seed re-fetches.
CRAWLUTRON_SITEMAP_LASTMOD_FUTURE_SKEW_SECONDS=86400

# --- Extraction limits (config/settings.py, pressure_sizing.py) ---
CRAWLUTRON_EXTRACTION_DOC_TIMEOUT=10.0
CRAWLUTRON_EXTRACTION_DOC_ACQUIRE_TIMEOUT=90.0
CRAWLUTRON_EXTRACTION_DOC_WORKERS=2
CRAWLUTRON_EXTRACTION_MAX_MARKDOWN=5242880
CRAWLUTRON_EXTRACTION_SELECTOR_TIMEOUT=2.0
CRAWLUTRON_DOC_TASK_RAM_BYTES=314572800

# --- Resource pressure / admission control (pressure_sizing.py) ---
# Per-task RAM budgets and the hard concurrency ceilings behind them.
CRAWLUTRON_HTTP_TASK_RAM_BYTES=50331648
CRAWLUTRON_BROWSER_TASK_RAM_BYTES=734003200
CRAWLUTRON_BROWSER_RAM_BYTES=734003200
CRAWLUTRON_BROWSER_RAM_FRACTION=0.5
CRAWLUTRON_MAX_HTTP_CONCURRENCY=512
CRAWLUTRON_MAX_DERIVED_POOL_SIZE=4
# Worker threads for the loop's shared asyncio.to_thread executor (#360): the
# pool every store/shaping/spill offload runs on. Default derives from the CPU
# quota (min(32, cpus+4)), floored at 8.
CRAWLUTRON_DEFAULT_EXECUTOR_WORKERS=8
# Optional fixed cap on concurrent tracked requests (/v1/crawl, /v1/map,
# /v1/render): 0 or unset disables it (saturation is resource-driven); a
# positive value refuses work with HTTP 503 once that many are active.
CRAWLUTRON_MAX_ACTIVE_REQUESTS=0

# --- probe_session.py only ---
# Probe target: the site probe_session.py renders and curls (https://example.com/ when unset).
CRAWLUTRON_PROBE_TARGET=https://example.com/
# Where the probe writes its JSONL findings (tmp/probe_out.txt when unset; empty keeps that default).
CRAWLUTRON_PROBE_OUTPUT=

# Process-wide settings cache (packages/core/crawlutron/config/settings_cache.py):
# get_cached_settings() parses os.environ once per process and returns the same
# object on later calls. reset_cached_settings() is test-only and refuses to
# re-parse mid-process unless CRAWLUTRON_TEST_ALLOW_SETTINGS_RESET=1 is set.
CRAWLUTRON_TEST_ALLOW_SETTINGS_RESET=
