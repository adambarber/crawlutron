{
    // basedpyright is the THIRD type checker here, alongside mypy (the fail
    // gate) and whatever AFT runs for live diagnostics. It earns its place by
    // finding annotation lies both declared gates miss: a `regex.Pattern` passed
    // where a `re.Pattern[str]` was declared, a symbol imported from the wrong
    // module, a `urllib.error` reference that only resolves because another
    // import happened to bind the submodule. Mypy passes those because the
    // `regex` package is untyped in its config and degrades the value to `Any`.
    //
    // Ruff is the single owner of style and the custom AST suite is the single
    // owner of project-specific safety predicates; this file is the single owner
    // of "the type annotation is a lie". Gated by a pre-commit hook running
    // basedpyright directly, whose finding count is zero-or-fail.
    "include": ["packages/core/crawlutron"],
    "exclude": [
        "tests",
        "scripts",
        "**/__pycache__",
        "**/.pytest_cache"
    ],

    // The crawler is a workspace member nested under packages/core, so that
    // directory is an import root: a file under packages/core/crawlutron is the
    // module ``crawlutron.*``, not ``packages.core.crawlutron.*``. Naming the
    // execution root keeps the two identities from colliding on one package.
    "executionEnvironments": [
        {
            "root": "packages/core",
            "extraPaths": ["packages/core"]
        }
    ],

    // The service runs 3.12. This was pinned to 3.11 and had never been run
    // against the real interpreter, so every finding it would have produced was
    // hypothetical. A config nobody executes is documentation, not a gate.
    "pythonVersion": "3.12",
    "typeCheckingMode": "basic",

    // Pyright honoring mypy's `# type: ignore` meant a suppression that satisfied
    // one checker could hide a finding from the other, and did: four bare
    // `# type: ignore[attr-defined]` in http_client_pool.py were muting
    // `Cannot assign to attribute "_bound_loop"` in pyright's own view of the
    // same four lines, and a bare `# type: ignore[return-value]` in
    // cgroup_sense.py was muting a real
    // `Type "object" is not assignable to return type "str | None"`. Mypy owns
    // its own comments -- `warn_unused_ignores` is on, and it is the declared
    // fail gate -- so pyright must not speak for it.
    "enableTypeIgnoreComments": false,

    // A suppression that suppresses nothing is a claim about the code that
    // nothing ever re-checks, and a comment explaining a suppression is
    // indistinguishable from a working one until the code underneath changes.
    // This rule turns that decay into a build failure.
    //
    // It also catches prose: a comment that quotes a suppression directive IS a
    // suppression directive, so an explanatory comment can silently mute the
    // line it sits on. The only live suppressions are in `extraction/doc_pool.py`
    // and `transport/cookie_jar.py`, each carrying the stdlib-over-narrow reason
    // for why it is there.
    "reportUnnecessaryTypeIgnoreComment": "error",

    "reportMissingTypeStubs": "none",
    "reportUnknownMemberType": "none",
    "reportUnknownVariableType": "none",
    "reportUnknownArgumentType": "none",
    "reportUnknownParameterType": "none",
    "reportUnknownLambdaType": "none",
    "reportMissingTypeArgument": "none",

    // curl_cffi and lxml do not mark re-exports, so importing a name that IS
    // present at runtime is reported as a private import. Verified directly
    // rather than assumed: `from curl_cffi.requests.models import STREAM_END`
    // succeeds on the installed 0.16.3, and `from lxml import etree` succeeds on
    // 6.1.3. Turning this off costs nothing and silences four findings that were
    // all wrong. It would have cost a great deal the other way: "fixing" the
    // STREAM_END import to satisfy the checker would have silently routed every
    // streaming fetch through the httpx fallback, because the import sits inside
    // a `try: ... except ImportError: return _fallback_to_httpx(...)`.
    //
    // The pydantic `Field(default_factory=...)` findings these comments used to
    // describe cannot be configured away -- they are reportArgumentType, which is
    // a rule we want -- so they were per-line ignores with a shared explanation.
    // There are none left; `reportUnnecessaryTypeIgnoreComment` above reports
    // each of them as having suppressed nothing.
    "reportPrivateImportUsage": "none"
}
