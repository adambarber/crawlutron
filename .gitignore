# Both spellings: a linked worktree reaches the venv through a `.venv` symlink,
# which the trailing-slash form does not match -- and a committed symlink into
# one checkout's venv is worse than no venv at all.
.venv/
.venv
.dynamic-task-ledger.json
*.egg-info/
.cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# Session-analysis residue written by the cortexkit tooling. It is ephemeral
# per-session output, not project content, and its own managed block already
# declares `magic-context/` untracked -- the historian XML under it was
# committed anyway, which is how a directory full of transcript digests ended
# up in the tree this service is extracted from.
.cortexkit/
logs/
cache/
.env
tmp/
*.log
.DS_Store

.coverage.*
