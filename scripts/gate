#!/usr/bin/env bash
# The one gate entry point every hook in .pre-commit-config.yaml runs through; why: docs/gate-helper.md
set -euo pipefail

# A gate that runs nothing is a gate that confirms nothing (docs/gate-helper.md):
# `exec "$@"` with no arguments is a no-op, so fail a zero-argument call loudly.
if [ "$#" -eq 0 ]; then
    echo "scripts/gate: no gate command supplied; a hook must name what to run" >&2
    echo "scripts/gate: invoke as 'scripts/gate <command...>' (see .pre-commit-config.yaml)" >&2
    exit 1
fi

# Dual layout, tried service-first then repo-root (docs/gate-helper.md). The
# nested candidate never exists here; the check is what survives vendoring.
top=$(git rev-parse --show-toplevel)
if [ -d "$top/docker/browser-crawler" ]; then
    service_root="$top/docker/browser-crawler"
else
    service_root="$top"
fi
cd "$service_root"

# Gate commands name the service's own pinned interpreter themselves, and this
# hands them through; check it exists so a missing venv blames the right thing.
if [ ! -x .venv/bin/python ]; then
    echo "scripts/gate: no interpreter at $service_root/.venv/bin/python" >&2
    echo "scripts/gate: these gates run against the pinned toolchain in pyproject.toml's dev extra" >&2
    echo "scripts/gate: create the service venv before committing" >&2
    exit 1
fi

exec "$@"
